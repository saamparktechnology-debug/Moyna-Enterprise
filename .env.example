# Copy to .env for local development. Never commit .env.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# Signs CSRF tokens. At least 32 random characters; keep it secret and different in every environment.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789

# Host port for the Docker PostgreSQL. Change it (and the ports in the URLs below) if 5432 is taken
# by another PostgreSQL on your machine.
POSTGRES_PORT=5432

# The API connects as erp_app (row-level security applies). The worker connects as erp_worker.
# Migrations and the seed use the owner account in MIGRATION_DATABASE_URL.
# `pnpm db:provision` gives the two roles these passwords. Use strong passwords outside local development.
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/erp_dev
WORKER_DATABASE_URL=postgresql://erp_worker:erp_worker@localhost:5432/erp_dev
MIGRATION_DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_dev

# Used only by the test suites (owner account of the test database).
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5432/erp_test

# First Super Admin and default branch created by `pnpm db:seed` (idempotent). Change these.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PASSWORD=change-me-before-first-use
SEED_BRANCH_CODE=HQ
SEED_BRANCH_NAME=Head Office
# 2-digit GST state code of this branch (for example 19 = West Bengal, 27 = Maharashtra).
SEED_BRANCH_STATE_CODE=19

# Where KYC documents are kept. An absolute folder outside the application folder; REQUIRED in production.
# Linux example: /var/lib/my-erp/kyc   Windows Server example: D:\my-erp-data\kyc
# Leave unset in development to use .my-erp/kyc in your home folder. Back it up with the database.
# KYC_STORAGE_PATH=
# local keeps files on disk (the default outside tests); memory forgets them on restart and is refused in production.
# STORAGE_DRIVER=local

# The most an Admin may approve as the valuation of an exchange, in rupees. Above it only a Super Admin may approve.
# Leave it out for no limit.
# EXCHANGE_ADMIN_APPROVAL_LIMIT=50000
